# Parámetros NO secretos de las funciones (los secretos van en Secret Manager).
# Este archivo SÍ se versiona: define a dónde vuelve el comprador después de pagar.
#
# Cambiar por el dominio real en cuanto exista el frontend; con este valor,
# success_url apunta a localhost y el comprador se queda mirando un error
# después de pagar.
SITE_URL=http://localhost:3000
