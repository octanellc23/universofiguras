# Parámetros NO secretos de las funciones (los secretos van en Secret Manager).
# Este archivo SÍ se versiona: define a dónde vuelve el comprador después de pagar.
#
# OJO: el cambio no surte efecto hasta redesplegar las funciones, y no conviene
# redesplegar hasta que el dominio resuelva de verdad. Si SITE_URL apunta a un
# dominio que todavía no existe, quien pague termina mirando un error del
# navegador justo después de darte su dinero.
SITE_URL=https://universofiguras.com
