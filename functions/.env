# Parámetros NO secretos de las funciones (los secretos van en Secret Manager).
# Este archivo SÍ se versiona: define a dónde vuelve el comprador después de
# pagar y desde qué dirección salen los correos.
SITE_URL=https://universofiguras.com

# Remitente de los correos transaccionales. El dominio tiene que estar
# verificado en Resend, o los correos salen y nadie los recibe.
# No necesita buzón: enviar y recibir son cosas distintas. Las respuestas van
# al correo de contacto que se configure en Panel → La tienda.
EMAIL_FROM=Universo Figuras <pedidos@universofiguras.com>
