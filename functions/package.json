{
  "name": "universo-figuras-functions",
  "version": "1.0.0",
  "description": "Cloud Functions v2 de Universo Figuras: checkout, webhook de Stripe, reservas de inventario",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check:shipping": "npm run build && node scripts/check-shipping.js",
    "seed": "node scripts/seed-firestore.js",
    "seed:emulator": "node scripts/seed-firestore.js --emulator",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
