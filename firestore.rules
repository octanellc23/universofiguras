rules_version = '2';

// Universo Figuras — reglas de Firestore
//
// Principio rector: el Admin SDK (Cloud Functions) IGNORA estas reglas. Por eso
// todo lo que toca dinero o inventario está denegado al cliente sin excepción,
// incluso para el admin. Estas reglas protegen contra un navegador
// comprometido, no contra el servidor.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------------------------------------------------------------------
    // products
    // ---------------------------------------------------------------------
    // Lectura pública solo de productos activos. OJO: en consultas (list) esta
    // condición no se evalúa documento por documento — el query DEBE llevar
    // where('status', '==', 'active') o Firestore lo rechaza entero.
    match /products/{productId} {
      allow get, list: if resource.data.status == 'active' || isAdmin();

      // El admin crea productos desde el panel, pero los contadores de
      // inventario nacen en un estado coherente y de ahí en adelante solo los
      // mueve el servidor (ver I3/I4 en CLAUDE.md).
      allow create: if isAdmin()
        && request.resource.data.reserved == 0
        && request.resource.data.available == request.resource.data.stock
        && request.resource.data.inStock == (request.resource.data.stock > 0);

      // stock / reserved / available / inStock son DERIVADOS y transaccionales.
      // Reponer inventario se hace con la callable adjustStockLevel, no editando el
      // documento a mano: si el admin sube 'stock' desde el navegador,
      // 'available' queda desfasado y se sobrevende.
      allow update: if isAdmin()
        && unchanged('stock')
        && unchanged('reserved')
        && unchanged('available')
        && unchanged('inStock');

      allow delete: if false; // se archiva (status: 'archived'), no se borra
    }

    // ---------------------------------------------------------------------
    // blog + videos
    // ---------------------------------------------------------------------
    match /posts/{postId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /videos/{youtubeId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // configuración
    // ---------------------------------------------------------------------
    // shipping y store son públicos: el frontend necesita mostrar "envío gratis
    // sobre $150" y los tiempos de entrega antes de cotizar.
    // fraud NO es público: revelar el umbral de revisión manual es decirle al
    // defraudador cuánto puede gastar sin que nadie lo mire.
    match /config/{docId} {
      allow get: if docId in ['shipping', 'store'] || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // dinero e inventario — solo Admin SDK
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false; // solo el servidor
    }

    match /reservations/{orderId} {
      allow read: if isAdmin(); // útil para depurar sobreventa
      allow write: if false;
    }

    match /inventoryLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // bitácora inmutable
    }

    // Idempotencia de webhooks. Nadie del lado del cliente tiene por qué
    // saber siquiera que existe.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // todo lo demás
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
