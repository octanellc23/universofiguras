# dependencias
node_modules/
.pnp
.pnp.js

# build
# OJO con los patrones sin barra inicial: "lib/" coincide con CUALQUIER carpeta
# llamada lib a cualquier profundidad, y se llevó src/lib/ entero — la mitad de
# la aplicación quedó fuera del repositorio sin que nada avisara, hasta que el
# build en la nube falló con "Module not found". Anclados desde la raíz.
/functions/lib/
.next/
/out/
/build/
/dist/
*.tsbuildinfo

# secretos — NUNCA versionar. Los secretos reales van en Secret Manager
# via defineSecret; esto es solo la red de seguridad.
.env
.env.*
!.env.example
# functions/.env solo tiene parámetros públicos (SITE_URL) y hace falta al
# desplegar: se versiona a propósito.
!functions/.env
# defineSecret lee de aquí al correr con los emuladores: es una clave de
# Stripe en texto plano.
.secret.local
*.secret.local
*.local
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

